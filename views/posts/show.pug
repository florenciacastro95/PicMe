extends ../layouts/layout

block metadata
  title= publicacion.titulo + ' - PicME!'
  meta(
    name="description"
    content="Descubrí esta publicación y compartí tu opinión en PicME!"
  )

block content
  .post-page

    //- Navegación
    .post-navigation
      a.post-back-link(href="/")
        i.ti.ti-arrow-left(aria-hidden="true")
        | Volver al inicio

    //- Encabezado de la publicación
    header.post-header-panel

      span.post-eyebrow
        | UNA PUBLICACIÓN ÚNICA Y DETERGENTE

      h1.post-title= publicacion.titulo

      if publicacion.descripcion
        p.post-description= publicacion.descripcion

      .post-author
        if publicacion.usuario.avatar
          img.post-author-avatar(
            src=publicacion.usuario.avatar
            alt=""
          )
        else
          span.post-author-avatar.post-avatar-fallback
            = (publicacion.usuario.username || 'U').charAt(0).toUpperCase()

        .post-author-info
          span.post-author-label Compartida por
          a.post-author-name(href="/profile/" + publicacion.usuario.username)
            = publicacion.usuario.nombre || publicacion.usuario.username
          span.post-author-username= '@' + publicacion.usuario.username

      if isOwner
        a.post-report-management(href="/reports/comments")
          i.ti.ti-flag(aria-hidden="true")
          | Revisar denuncias de comentarios

      if isOwner && bloqueadaPorDenuncias
        .post-warning
          i.ti.ti-lock(aria-hidden="true")
          .post-warning-text
            strong Publicación bloqueada.
            |  Una o más imágenes recibieron denuncias pendientes de revisión. No podés modificar la publicación hasta que sean resueltas.

    //- Galería de fotografías
    if publicacion.imagenes && publicacion.imagenes.length > 0

      .post-gallery-heading
        div
          span.post-section-kicker NUESTRA PEQUEÑA EXPOSICIÓN
          h2 Fotografías
        span.post-image-total
          i.ti.ti-photo(aria-hidden="true")
          = publicacion.imagenes.length
          |  imágenes

      section.post-images-grid(aria-label="Fotografías de la publicación")

        each imagen, index in publicacion.imagenes
          article.post-image-card

            //- Fotografía
            figure.post-image-figure
              img.post-detail-image(
                src=imagen.url
                alt=publicacion.titulo + ' - fotografía ' + (index + 1)
                loading="lazy"
              )

              figcaption.post-image-caption
                span Foto #{index + 1}

                if imagen.copyright === 'copyright'
                  span.post-copyright
                    i.ti.ti-copyright(aria-hidden="true")
                    | Con copyright
                else
                  span.post-free
                    i.ti.ti-world(aria-hidden="true")
                    | Libre

            .post-image-content

              //- VALORACIONES
              section.post-rating-section

                .post-rating-summary
                  div
                    span.post-rating-label Valoración promedio
                    .post-rating-score
                      i.ti.ti-star-filled(aria-hidden="true")
                      strong= imagen.promedio || '0.0'
                      span / 5

                  span.post-rating-votes
                    = imagen.totalVotos || 0
                    |  votos

                .progress.post-rating-progress(
                  role="progressbar"
                  aria-label="Promedio de valoraciones"
                  aria-valuenow=Number(imagen.promedio) || 0
                  aria-valuemin="0"
                  aria-valuemax="5"
                )
                  .progress-bar(
                    style=`width:${((Number(imagen.promedio) || 0) / 5) * 100}%`
                  )

                if user && user.id !== publicacion.usuario_id

                  form.post-rating-form(
                    action="/ratings/imagen/" + imagen.id
                    method="POST"
                  )
                    span.post-form-label
                      if imagen.miValoracion
                        | Tu valoración: #{imagen.miValoracion}/5. ¡Podés cambiarla!
                      else
                        | ¿Cuánto te gusta esta fotografía?

                    .rating-options
                      each val in [1, 2, 3, 4, 5]
                        button.rating-choice(
                          type="submit"
                          name="puntuacion"
                          value=val
                          class=(imagen.miValoracion == val ? 'is-selected' : '')
                          title=val + ' de 5 estrellas'
                          aria-label='Valorar con ' + val + ' de 5 estrellas'
                        )= val

              //- DENUNCIAS DE IMÁGENES
              if user && user.id !== publicacion.usuario_id

                .post-report-section
                  if imagen.denunciadaPorMi
                    p.post-report-done
                      i.ti.ti-check-circle(aria-hidden="true")
                      | Ya denunciaste esta imagen.

                  else
                    details.post-details
                      summary.post-details-summary
                        i.ti.ti-flag(aria-hidden="true")
                        | Denunciar imagen

                      form.post-report-form(
                        action="/reports/images/" + imagen.id
                        method="POST"
                      )
                        .mb-2
                          label.form-label(for='motivo-imagen-' + imagen.id)
                            | Motivo de denuncia

                          select.form-select(
                            id='motivo-imagen-' + imagen.id
                            name="motivo"
                            required
                          )
                            option(value="" disabled selected)
                              | Seleccioná un motivo
                            option(value="spam") Spam o publicidad no solicitada
                            option(value="contenido_inapropiado") Contenido inapropiado
                            option(value="derechos_autor") Derechos de autor
                            option(value="acoso") Acoso o contenido ofensivo
                            option(value="otro") Otro

                        .mb-2
                          label.form-label(for='descripcion-imagen-' + imagen.id)
                            | Justificación

                          textarea.form-control(
                            id='descripcion-imagen-' + imagen.id
                            name="descripcion"
                            required
                            minlength="10"
                            maxlength="1000"
                            rows="3"
                            placeholder="Explicá por qué denunciás esta imagen..."
                          )

                        button.btn.btn-sm.btn-outline-danger(type="submit")
                          i.ti.ti-send.me-1(aria-hidden="true")
                          | Enviar denuncia

              //- COMENTARIOS
              section.post-comments-section

                .post-comments-heading
                  h3
                    i.ti.ti-message-circle(aria-hidden="true")
                    | Comentarios

                  span.post-comment-count
                    = imagen.comentarios ? imagen.comentarios.length : 0

                if publicacion.comentarios_habilitados

                  if user
                    form.post-comment-form(
                      action="/comments/" + imagen.id
                      method="POST"
                    )
                      label.visually-hidden(for='comentario-' + imagen.id)
                        | Escribí un comentario

                      textarea.form-control(
                        id='comentario-' + imagen.id
                        name="contenido"
                        required
                        maxlength="1000"
                        rows="2"
                        placeholder="Dejá tu opinión sobre esta fotografía..."
                      )

                      button.btn.btn-pink.btn-sm(type="submit")
                        i.ti.ti-send.me-1(aria-hidden="true")
                        | Comentar

                  else
                    p.post-login-hint
                      | ¿Tenés algo lindo para decir?
                      a(href="/auth/login") Iniciá sesión para comentar.

                else
                  .post-comments-disabled
                    i.ti.ti-lock(aria-hidden="true")
                    | Los comentarios están deshabilitados para esta publicación.

                //- LISTADO DE COMENTARIOS
                if imagen.comentarios && imagen.comentarios.length > 0

                  .post-comment-list

                    each comentario in imagen.comentarios
                      article.post-comment

                        if comentario.usuario && comentario.usuario.avatar
                          img.post-comment-avatar(
                            src=comentario.usuario.avatar
                            alt=""
                            loading="lazy"
                          )
                        else
                          span.post-comment-avatar.post-avatar-fallback
                            if comentario.usuario
                              = (comentario.usuario.username || 'U').charAt(0).toUpperCase()
                            else
                              i.ti.ti-user(aria-hidden="true")

                        .post-comment-content

                          .post-comment-author
                            strong
                              if comentario.usuario
                                = comentario.usuario.username
                                if comentario.usuario.activo === false
                                  span.post-account-suspended Cuenta suspendida
                              else
                                | Usuario eliminado

                          p.post-comment-text= comentario.contenido

                          .post-comment-actions

                            //- El autor del comentario puede eliminarlo
                            if user && user.id === comentario.usuario_id
                              form(
                                action="/comments/" + comentario.id + "/delete"
                                method="POST"
                              )
                                button.post-comment-delete(
                                  type="submit"
                                )
                                  i.ti.ti-trash(aria-hidden="true")
                                  | Eliminar

                            //- Denunciar comentarios ajenos
                            if user && !isOwner && user.id !== comentario.usuario_id && comentario.usuario_id !== publicacion.usuario_id

                              details.post-details.post-comment-report
                                summary.post-details-summary
                                  i.ti.ti-flag(aria-hidden="true")
                                  | Denunciar

                                form.post-report-form(
                                  action="/reports/comments/" + comentario.id
                                  method="POST"
                                )
                                  .mb-2
                                    label.visually-hidden(
                                      for='motivo-comentario-' + comentario.id
                                    )
                                      | Motivo de denuncia

                                    select.form-select.form-select-sm(
                                      id='motivo-comentario-' + comentario.id
                                      name="motivo"
                                      required
                                    )
                                      option(value="" disabled selected)
                                        | Seleccioná un motivo
                                      option(value="spam") Spam o publicidad no solicitada
                                      option(value="contenido_inapropiado") Contenido inapropiado
                                      option(value="derechos_autor") Derechos de autor
                                      option(value="acoso") Acoso o contenido ofensivo
                                      option(value="otro") Otro

                                  textarea.form-control.form-control-sm.mb-2(
                                    name="descripcion"
                                    required
                                    minlength="10"
                                    maxlength="1000"
                                    rows="2"
                                    placeholder="Justificá la denuncia..."
                                  )

                                  button.btn.btn-sm.btn-outline-danger(type="submit")
                                    | Enviar denuncia

                else
                  p.post-no-comments
                    | Todavía no hay comentarios. ¡Alguien tiene que romper el hielo!

    else
      .empty-state.text-center.py-5
        i.ti.ti-photo-off(aria-hidden="true")
        h2 No hay fotografías disponibles
        p.text-muted Esta publicación todavía no tiene imágenes para mostrar.

    //- Etiquetas
    if publicacion.tags && publicacion.tags.length > 0
      section.post-tags-section
        h2.post-secondary-heading
          i.ti.ti-hash(aria-hidden="true")
          | Etiquetas

        .post-tags
          each tag in publicacion.tags
            a.post-tag(
              href="/search?q=" + encodeURIComponent(tag.nombre)
            )= '#' + tag.nombre

    //- Acciones del propietario
    if isOwner && !bloqueadaPorDenuncias
      section.post-owner-actions
        span.post-section-kicker GESTIÓN DE TU PUBLICACIÓN

        .post-owner-buttons
          a.btn.btn-edit(href="/posts/" + publicacion.id + "/edit")
            i.ti.ti-pencil.me-1(aria-hidden="true")
            | Editar publicación

          form(
            action="/posts/" + publicacion.id + "/delete"
            method="POST"
          )
            button.btn.btn-danger(type="submit")
              i.ti.ti-trash.me-1(aria-hidden="true")
              | Eliminar publicación

          form(
            action="/posts/" + publicacion.id + "/habcomments"
            method="POST"
          )
            if publicacion.comentarios_habilitados
              button.btn.btn-comments(type="submit")
                i.ti.ti-message-off.me-1(aria-hidden="true")
                | Deshabilitar comentarios
            else
              button.btn.btn-success(type="submit")
                i.ti.ti-message-check.me-1(aria-hidden="true")
                | Habilitar comentarios