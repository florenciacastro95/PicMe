doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name="theme-color" content="#C21870")
    link(rel="icon" type="image/x-icon" href="/assets/logo.ico")
    block metadata
      title PicME!

    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
      rel="stylesheet")
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.52.0/dist/tabler-icons.min.css")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css")
    link(rel="stylesheet" href="/css/styles.css")
    link(rel="stylesheet" href="/css/picme-theme.css")

  body.app-body
    header.site-header
      .site-header-main
        .container.app-container.header-content
          a.brand(href="/" aria-label="PicME! - Inicio")
            span.brand-mark
              i.ti.ti-camera-heart(aria-hidden="true")
            span.brand-name PicME!

          if user
            .dropdown.account-dropdown
              button.account-trigger(
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                aria-label="Abrir menú de cuenta"
              )
                if user.avatar
                  img.account-avatar(src=user.avatar alt="" loading="lazy")
                else
                  span.account-avatar.account-avatar-fallback
                    = (user.username || 'U').charAt(0).toUpperCase()
                span.account-username= user.username
                i.ti.ti-chevron-down.account-chevron(aria-hidden="true")

              ul.dropdown-menu.dropdown-menu-end.account-menu
                li
                  a.dropdown-item(href="/profile/" + user.username)
                    i.ti.ti-user-circle.me-2(aria-hidden="true")
                    | Mi perfil

                li
                  a.dropdown-item(href="/reports/comments")
                    i.ti.ti-flag.me-2(aria-hidden="true")
                    | Denuncias

                if user.rol === 'validador' || user.rol === 'admin'
                  li
                    a.dropdown-item(href="/reports/moderation")
                      i.ti.ti-shield-check.me-2(aria-hidden="true")
                      | Moderación

                li
                  hr.dropdown-divider

                li
                  form(action="/auth/logout" method="POST")
                    button.dropdown-item.dropdown-logout(type="submit")
                      i.ti.ti-logout.me-2(aria-hidden="true")
                      | Cerrar sesión

          else
            .guest-actions
              a.guest-login(href="/auth/login") Iniciar sesión
              a.btn.btn-pink.btn-sm(href="/auth/register") Registrarse

      nav.site-nav(aria-label="Navegación principal")
        .container.app-container.site-nav-content
          a.site-nav-link(href="/")
            i.ti.ti-home(aria-hidden="true")
            span Inicio

          a.site-nav-link(href="/search")
            i.ti.ti-compass(aria-hidden="true")
            span Explorar

          if user
            a.site-nav-link(href="/follow/feed" aria-label="Publicaciones de usuarios que sigo")
              i.ti.ti-users(aria-hidden="true")
              span Siguiendo
            a.site-nav-link.site-nav-create(href="/posts/create")
              i.ti.ti-plus(aria-hidden="true")
              span Nueva publicación

    main.app-main
      .container.app-container.page-container
        if alert
          .alert.alert-dismissible.fade.show(class="alert-" + alert.type role="alert")
            | #{alert.text}
            button.btn-close(type="button" data-bs-dismiss="alert" aria-label="Cerrar")
        block content

    footer.site-footer
      .container.app-container.footer-content
        a.footer-brand(href="/")
          i.ti.ti-camera-heart(aria-hidden="true")
          span PicME!
        p.footer-copy
          | Proyecto universitario · FOTAZA 2 · Programación Web 2 · ULP

    script.
      (function () {
        const currentPath = window.location.pathname;
        const ref = document.referrer;

        if (ref && !ref.includes(currentPath) && !ref.includes('/comments') && !ref.includes('/ratings')) {
          sessionStorage.setItem('prev_page_' + currentPath, ref);
        }
      })();

      function goBack(fallback) {
        const currentPath = window.location.pathname;
        const guardado = sessionStorage.getItem('prev_page_' + currentPath);
        window.location.href = guardado || fallback || '/';
      }
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js")